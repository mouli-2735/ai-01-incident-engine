# Copy to .env and fill in. .env must be in .gitignore — never commit it.

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ai01

PORT=3000

# Live alert generation (lib/alertGenerator.js) — simulates a real monitoring
# feed by writing a new Alert every LIVE_ALERTS_INTERVAL_MS. Set
# LIVE_ALERTS=false to disable (e.g. for a scripted demo run on fixed seed
# data only).
LIVE_ALERTS=true
LIVE_ALERTS_INTERVAL_MS=8000

# Added in Step 4 / Step 9 — leave blank for now
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
GEMINI_API_KEY=
